{
    "name": "chassisphp/chassisphp-skeleton",
    "description": "Skeleton app for the ChassisPHP Framework. This app is a starting point for developing your own site/application.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Roger Creasy",
            "email": "roger.creasy@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app",
            "Database\\": "Database"
        }
    },
    "require": {
        "php": "^8.3",
        "chassisphp/chassisphp": "0.7.x-dev"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "guzzlehttp/guzzle": "^7.15.2",
        "symfony/process": "^7.0"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
